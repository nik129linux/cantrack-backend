                "bidding",
                "requests",
                "{{walkId}}",
                "approach"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"enRouteAt\", \"position\", \"pickup\", \"route\"); });",
                  "pm.test(\"the tap time\", function () { pm.expect(pm.response.json().enRouteAt).to.eql(pm.environment.get(\"enRouteAt\")); });",
                  "pm.test(\"walker position\", function () { var p = pm.response.json().position; pm.expect(p.lat).to.eql(1.212); pm.expect(p.lng).to.eql(-77.283); });",
                  "pm.test(\"pickup is the house\", function () { pm.expect(pm.response.json().pickup).to.eql({ lat: 1.2136, lng: -77.2811 }); });",
                  "pm.test(\"route follows the streets or falls back to the straight line\", function () { var r = pm.response.json().route; pm.expect(r.source).to.be.oneOf([\"osrm\", \"straight\"]); pm.expect(r.geometry.length).to.be.at.least(2); pm.expect(r.minutes).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
