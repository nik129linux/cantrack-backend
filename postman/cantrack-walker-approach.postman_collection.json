        {
          "name": "Owner follows the walker: position and street route",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/approach",
              "host": [
                "{{baseUrl}}"
