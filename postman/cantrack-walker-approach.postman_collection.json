                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"enRouteAt on the stop\", function () { var stop = pm.response.json().stops.find(function (s) { return s.requestId === pm.environment.get(\"walkId\"); }); pm.expect(stop.enRouteAt).to.eql(pm.environment.get(\"enRouteAt\")); });"
                ]
              }
            }
          ]
