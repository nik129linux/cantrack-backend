                  "pm.test(\"me -> the pickup, at least two points\", function () { var b = pm.response.json(); pm.expect(b.source).to.be.oneOf([\"osrm\", \"straight\"]); pm.expect(b.geometry.length).to.be.at.least(2); b.geometry.forEach(function (pt) { pm.expect(pt).to.have.lengthOf(2); }); });"
                ]
