{
  "info": {
    "name": "CanTrack — Walker approach (Voy en camino + street routes)",
    "description": "Rutas along the streets and the owner following the walker. Needs migration 008 (walk_requests.en_route_at). Run top to bottom: the happy path creates the walk the exploits then probe. Variables: baseUrl, ownerToken, otherOwnerToken, walkerToken, walkerId, walker2Token, dogId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Owner publishes a walk (Pasto pickup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dogId\": \"{{dogId}}\",\n  \"windowStart\": \"{{windowStart}}\",\n  \"durationHours\": 1.0,\n  \"priceCop\": 30000,\n  \"pickupLat\": 1.2136,\n  \"pickupLng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The API only accepts walks inside the next 30 days: start two days from now at 09:00 Bogota.",
                  "const start = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);",
                  "start.setUTCHours(14, 0, 0, 0);",
                  "pm.environment.set(\"windowStart\", start.toISOString());",
                  "// The local (Bogota) day of that walk, for the day-path request.",
                  "pm.environment.set(\"walkDay\", start.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", function () { pm.response.to.have.status(201); });",
                  "pm.environment.set(\"walkId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Walker goes online",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"online\": true,\n  \"lat\": 1.2136,\n  \"lng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
