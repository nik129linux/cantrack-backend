{
  "info": {
    "name": "CanTrack — Walker Perfil",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Walker tab 'perfil': Happy path then Exploits; every exploit must get the 4xx in its name. Environment: baseUrl, walkerToken, walkerId, otherWalkerToken, otherWalkerId, ownerToken, ownerId, dogId. Run top to bottom: later requests use ids the earlier ones store."
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Save my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"displayName\": \"Paseador Demo\", \"bio\": \"Paseo perros en el centro\", \"serviceArea\": \"Centro\", \"pricePerWalk\": 18000, \"phone\": \"+57 300 000 0000\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read my profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"walkerId\", \"email\", \"displayName\", \"bio\", \"serviceArea\", \"pricePerWalk\", \"phone\", \"avatarUrl\", \"consent\", \"stats\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Record consent (Ley 1581)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/consent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "consent"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"version\": \"2026-10\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Upcoming walks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/walks?tab=upcoming",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "walks"
              ],
              "query": [
                {
                  "key": "tab",
                  "value": "upcoming"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Past walks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/walks?tab=past",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "walks"
              ],
              "query": [
                {
                  "key": "tab",
                  "value": "past"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Export my data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "export"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"exportedAt\", \"profile\", \"position\", \"offers\", \"walks\", \"ratingsReceived\"); });",
                  "pm.test(\"no embeddings\", function () { pm.expect(pm.response.text()).to.not.include(\"embedding\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
