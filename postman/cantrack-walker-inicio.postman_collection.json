{
  "info": {
    "name": "CanTrack — Walker Inicio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Walker tab 'inicio': Happy path then Exploits; every exploit must get the 4xx in its name. Environment: baseUrl, walkerToken, walkerId, otherWalkerToken, otherWalkerId, ownerToken, ownerId, dogId. Run top to bottom: later requests use ids the earlier ones store."
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Go online at my position",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"online\": true, \"lat\": 1.214, \"lng\": -77.2811}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"online\", function () { pm.expect(pm.response.json().online).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Home panel in one call",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "home"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"greetingName\", \"online\", \"activeWalk\", \"nextWalk\", \"today\", \"rating\", \"openNearby\", \"pendingOffers\"); });",
                  "pm.test(\"online after the switch\", function () { pm.expect(pm.response.json().online).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Earnings this week (simulated 10%)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/earnings?period=week",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "earnings"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "week"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"seven days, simulated\", function () { const b = pm.response.json(); pm.expect(b.byDay.length).to.eql(7); pm.expect(b.simulated).to.eql(true); pm.expect(b.netCop).to.eql(b.grossCop - b.commissionCop); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Earnings this month",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/earnings?period=month",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "earnings"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "month"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Go offline erases my location",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"online\": false}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"offline\", function () { pm.expect(pm.response.json()).to.eql({online: false, updatedAt: null}); });"
                ]
              }
            }
          ]
        }
      ]
    },
