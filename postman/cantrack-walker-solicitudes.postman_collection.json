              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"counter\", function () { pm.expect(pm.response.json().kind).to.eql(\"counter\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner sees the counter in the ranked list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
