{
  "info": {
    "name": "CanTrack — Walker Solicitudes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Walker tab 'solicitudes': Happy path then Exploits; every exploit must get the 4xx in its name. Environment: baseUrl, walkerToken, walkerId, otherWalkerToken, otherWalkerId, ownerToken, ownerId, dogId. Run top to bottom: later requests use ids the earlier ones store."
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Owner posts an open request (setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"dogId\": \"{{dogId}}\", \"windowStart\": \"{{windowStart}}\", \"durationMinutes\": 45, \"priceCop\": 20000, \"pickupLat\": 1.2136, \"pickupLng\": -77.2811}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 26 * 3600 * 1000); start.setUTCMinutes(0, 0, 0);",
                  "pm.environment.set('windowStart', start.toISOString().replace('.000Z', '+00:00'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", function () { pm.response.to.have.status(201); });",
                  "pm.environment.set(\"requestId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Go online (setup)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"online\": true, \"lat\": 1.214, \"lng\": -77.2811}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Inbox shows the request with its card",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "open"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"card\", function () { const c = pm.response.json().find(r => r.id === pm.environment.get(\"requestId\")); pm.expect(c).to.include.keys(\"dogName\", \"ownerName\", \"fareCop\", \"distanceKm\", \"myOffer\"); pm.expect(c.myOffer).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept the owner's fare in one tap",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{requestId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{requestId}}",
                "offers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"kind\": \"accept\", \"etaMin\": 8}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"accept at the fare\", function () { const b = pm.response.json(); pm.expect(b.kind).to.eql(\"accept\"); pm.expect(b.priceCop).to.eql(20000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "My offers: pending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walkers/{{walkerId}}/offers?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walkers",
                "{{walkerId}}",
                "offers"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"listed\", function () { pm.expect(pm.response.json().map(o => o.requestId)).to.include(pm.environment.get(\"requestId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw my offer",
