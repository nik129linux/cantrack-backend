{
  "info": {
    "name": "CanTrack — Owner inicio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Owner tab 'inicio': Happy path then Exploits; every exploit must get the 4xx in its name. Environment: baseUrl, ownerToken, ownerId, otherOwnerToken, otherOwnerId, walkerToken, dogId, otherDogId, otherDogName."
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Home panel in one call",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "home"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"greetingName\", \"activeWalk\", \"nextWalk\", \"upcoming\", \"openRequests\", \"counts\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Weather card (Open-Meteo through the API)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/weather?lat=1.2136&lng=-77.2811",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "weather"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "1.2136"
                },
                {
                  "key": "lng",
                  "value": "-77.2811"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200, or 503 if Open-Meteo is down (never 500)\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Exploits",
      "item": [
        {
          "name": "IDOR: another owner's home → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "home"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"path guard\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Walker reads an owner home → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "home"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"owners only\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "No token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "home"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"auth\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Weather with bad coordinates → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/weather?lat=91&lng=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "weather"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "91"
                },
                {
                  "key": "lng",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"validated\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Weather without a token → 401 (not an open proxy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/weather?lat=1.2136&lng=-77.2811",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "weather"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "1.2136"
                },
                {
                  "key": "lng",
                  "value": "-77.2811"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"auth\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
