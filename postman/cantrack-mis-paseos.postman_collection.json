            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"hidden\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
