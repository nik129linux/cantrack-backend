          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"hidden\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "IDOR: another owner lists my walks → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/walks?tab=past",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
