                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"path guard\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner injects GPS points → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/gps",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "gps"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": [\n    {\n      \"lat\": 1.2,\n      \"lng\": -77.2,\n      \"atEpoch\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"assigned walker only\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unassigned walker injects GPS → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/gps",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "gps"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": [\n    {\n      \"lat\": 1.2,\n      \"lng\": -77.2,\n      \"atEpoch\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"assigned walker only\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Another owner repeats my walk → 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              },
