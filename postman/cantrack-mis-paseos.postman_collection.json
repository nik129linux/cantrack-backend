                "{{walkId}}",
                "repeat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"windowStart\": \"{{windowStart}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not yours\", function () { pm.response.to.have.status(404); });"
                ]
