{
  "info": {
    "name": "CanTrack — Owner perfil",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Owner tab 'perfil': Happy path then Exploits; every exploit must get the 4xx in its name. Environment: baseUrl, ownerToken, ownerId, otherOwnerToken, otherOwnerId, walkerToken, dogId, otherDogId, otherDogName."
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Read my profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"ownerId\", \"email\", \"displayName\", \"phone\", \"avatarUrl\", \"home\", \"consent\", \"stats\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Save my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Owner Test\",\n  \"phone\": \"+57 300 000 0000\",\n  \"home\": {\n    \"lat\": 1.2136,\n    \"lng\": -77.2811,\n    \"label\": \"Pasto centro\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"saved\", function () { pm.expect(pm.response.json().displayName).to.eql(\"Owner Test\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Record consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/consent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "consent"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"2026-10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Export my data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "export"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"downloads as a file\", function () { pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"cantrack-export.json\"); });",
                  "pm.test(\"no face embeddings\", function () { pm.expect(pm.response.text()).to.not.include(\"embedding\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Exploits",
      "item": [
        {
          "name": "IDOR: another owner reads my profile → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"path guard\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "IDOR: another owner edits my profile → 403",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"pwned\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"path guard\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Body tries to retarget the row (ownerId ignored)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Owner Test\",\n  \"ownerId\": \"{{otherOwnerId}}\",\n  \"owner_id\": \"{{otherOwnerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"still mine\", function () { pm.expect(pm.response.json().ownerId).to.eql(pm.environment.get(\"ownerId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Phone injection → 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"x\",\n  \"phone\": \"<script>alert(1)</script>\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"validated\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "IDOR: another owner exports my data → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "export"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"path guard\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "IDOR: another owner deletes my account → 403",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm\": \"DELETE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"path guard\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete without the exact confirmation → 400 (nothing deleted)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm\": \"yes\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"confirmation required\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Walker reads an owner profile → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"owners only\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
