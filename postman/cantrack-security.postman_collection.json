                  "pm.test(\"non-finite numbers refused\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E13 window in year 9999 → 400 (was a 500)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dogId\": \"{{dogId}}\",\n  \"windowStart\": \"9999-12-31T23:59:59+00:00\",\n  \"durationHours\": 1,\n  \"priceCop\": 25000,\n  \"pickupLat\": 1.2136,\n  \"pickupLng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"window must be within 30 days\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E14 non-UUID id → 404, no SQL text",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/not-a-uuid/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "not-a-uuid",
                "offers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"4xx, never 500\", function () { pm.expect(pm.response.code).to.be.within(400, 499); });",
                  "pm.test(\"response leaks nothing internal\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"invalid input syntax\");",
                  "    pm.expect(text).to.not.include(\"uuid\");",
                  "    pm.expect(text).to.not.include(\"postgres\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E15 1.1 MB JSON body → 413",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dogs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{bigName}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"body size capped\", function () {",
                  "    pm.response.to.have.status(413);",
                  "});",
                  "pm.environment.unset(\"bigName\");"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"bigName\", \"x\".repeat(1100000));"
                ]
              }
            }
          ]
        },
        {
          "name": "E16 validation errors don't reflect input (XSS probe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<script>alert(1)</script>\",\n  \"password\": \"x\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"invalid email refused\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"response leaks nothing internal\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"<script>\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E17 login: unknown email and wrong password look identical",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody-{{$randomUUID}}@example.com\",\n  \"password\": \"wrong-password\"\n}"
