{
  "info": {
    "name": "CanTrack — Security exploits (PR0)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every request is an attack a user can run with their own token. Each one must fail with the 4xx in its name. Run Setup first (it posts a walk and stores walkId), then Exploits. Fill ownerToken, otherOwnerToken, walkerToken, dogId (owned by the owner), otherDogId + otherDogName (a dog of the other owner). Set isProduction=true against Render."
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Post a walk request (owner) — stores walkId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dogId\": \"{{dogId}}\",\n  \"windowStart\": \"{{windowStart}}\",\n  \"durationHours\": 1,\n  \"priceCop\": 25000,\n  \"pickupLat\": 1.2136,\n  \"pickupLng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 walk posted\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.environment.set(\"walkId\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A window 2 days ahead, always inside the 30-day limit.",
                  "const start = new Date(Date.now() + 2 * 24 * 3600 * 1000);",
                  "start.setUTCMinutes(0, 0, 0);",
                  "pm.environment.set(\"windowStart\", start.toISOString().replace(\".000Z\", \"+00:00\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Exploits",
      "item": [
        {
          "name": "E01 /_whoami (the professor's /me) is gone → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/_whoami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "_whoami"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"identity echo endpoint removed\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E02 no token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dogs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"guarded route needs a token\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E03 forged token → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiJ9.e30.forged"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dogs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"forged JWT refused\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E04 owner calls a walker endpoint (bid on own walk) → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "offers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceCop\": 20000,\n  \"etaMin\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"role comes from the server, not the client\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E05 role cannot be re-picked → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"walker\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"role is set once, server-side\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E06 IDOR: another owner reads my offers → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "offers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not your walk\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E07 IDOR: another owner picks on my walk → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherOwnerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/pick",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "pick"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not your walk\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E08 IDOR: walker routes a stranger's dog → 403, name not leaked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stops\": [\n    {\n      \"dogId\": \"{{otherDogId}}\",\n      \"pickupTime\": \"{{windowStart}}\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"only dogs from walks assigned to you\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"response leaks nothing internal\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"{{otherDogName}}\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E09 owner creates a route → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "routes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stops\": [\n    {\n      \"dogId\": \"{{dogId}}\",\n      \"pickupTime\": \"{{windowStart}}\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"routes are walker-only\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E10 walker creates a dog → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dogs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"dogs are owner-only\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E11 int32 overflow price → 400 (was a 500 with Postgres text)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dogId\": \"{{dogId}}\",\n  \"windowStart\": \"{{windowStart}}\",\n  \"durationHours\": 1,\n  \"priceCop\": 2147483648,\n  \"pickupLat\": 1.2136,\n  \"pickupLng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"price capped at 1,000,000 COP\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"response leaks nothing internal\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"out of range for type\");",
                  "    pm.expect(text).to.not.include(\"postgres\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E12 Infinity ETA → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "offers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"priceCop\": 20000, \"etaMin\": Infinity}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
