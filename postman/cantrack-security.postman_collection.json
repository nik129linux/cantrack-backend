        {
          "name": "E18 security headers on every response",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"health is public\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"HSTS + nosniff + DENY\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Strict-Transport-Security\")).to.include(\"max-age=\");",
                  "    pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\");",
                  "    pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.eql(\"DENY\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E19 Swagger hidden in production",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 in production, 200 in dev\", function () {",
                  "    const prod = pm.environment.get(\"isProduction\") === \"true\";",
                  "    pm.response.to.have.status(prod ? 404 : 200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E20 login flood → 429 on the 6th try",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"flood@example.com\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.environment.get(\"floodCount\"));",
                  "if (n < 6) {",
                  "    postman.setNextRequest(\"E20 login flood → 429 on the 6th try\");",
                  "} else {",
                  "    pm.environment.unset(\"floodCount\");",
                  "    pm.test(\"6th login in a minute is rate-limited\", function () { pm.response.to.have.status(429); });",
                  "    pm.test(\"Retry-After header\", function () { pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0); });",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.environment.get(\"floodCount\") || 0) + 1;",
                  "pm.environment.set(\"floodCount\", n);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
