          "name": "Forged pagination cursor → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/requests?cursor=eyJub3QiOiJhLWN1cnNvciJ9",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "requests"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "eyJub3QiOiJhLWN1cnNvciJ9"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
