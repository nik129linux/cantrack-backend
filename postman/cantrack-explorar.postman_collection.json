              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dogId\": \"{{dogId}}\",\n  \"windowStart\": \"{{windowStart}}\",\n  \"durationMinutes\": 60,\n  \"durationHours\": 1,\n  \"priceCop\": 15000,\n  \"pickupLat\": 1.2,\n  \"pickupLng\": -77.2\n}"
            }
