{
  "info": {
    "name": "CanTrack — Owner explorar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Owner tab 'explorar': Happy path then Exploits; every exploit must get the 4xx in its name. Environment: baseUrl, ownerToken, ownerId, otherOwnerToken, otherOwnerId, walkerToken, dogId, otherDogId, otherDogName."
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Fare suggestion (45 min)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/fare-suggestion?durationMinutes=45&lat=1.2136&lng=-77.2811",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "fare-suggestion"
              ],
              "query": [
                {
                  "key": "durationMinutes",
                  "value": "45"
                },
                {
                  "key": "lat",
                  "value": "1.2136"
                },
                {
                  "key": "lng",
                  "value": "-77.2811"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"suggestedCop\", \"basis\", \"sampleSize\", \"minCop\", \"stepCop\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Nearby walkers (count only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/nearby-walkers?lat=1.2136&lng=-77.2811",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "nearby-walkers"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "1.2136"
                },
                {
                  "key": "lng",
                  "value": "-77.2811"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"shape\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"count\", \"radiusKm\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Walker reports a position",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{walkerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/walker-position",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "walker-position"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 1.2136,\n  \"lng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Post a 45-minute request (stores walkId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dogId\": \"{{dogId}}\",\n  \"windowStart\": \"{{windowStart}}\",\n  \"durationMinutes\": 45,\n  \"priceCop\": 15000,\n  \"pickupLat\": 1.2136,\n  \"pickupLng\": -77.2811\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", function () { pm.response.to.have.status(201); });",
                  "pm.environment.set(\"walkId\", pm.response.json().id);",
                  "pm.test(\"45 min stored as 0.75 h\", function () { pm.expect(pm.response.json().durationHours).to.eql(0.75); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 2 * 24 * 3600 * 1000);",
                  "start.setUTCMinutes(0, 0, 0);",
                  "pm.environment.set(\"windowStart\", start.toISOString().replace(\".000Z\", \"+00:00\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "My requests include it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}/requests?status=open&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}",
                "requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"listed\", function () { pm.expect(pm.response.json().items.map(i => i.id)).to.include(pm.environment.get(\"walkId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Offers + ETag",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "offers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"offersEtag\", pm.response.headers.get(\"ETag\"));",
                  "pm.test(\"ETag present\", function () { pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\".+\"$/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Same offers again → 304",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "If-None-Match",
                "value": "{{offersEtag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/{{walkId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "{{walkId}}",
                "offers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"nothing changed\", function () { pm.response.to.have.status(304); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Assistant drafts a typed request (200, or 503 when the model is off)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bidding/requests/parse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bidding",
                "requests",
                "parse"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Firulais pasado ma\\u00f1ana a las 5pm, 45 minutos, 15 mil\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"never 500\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });",
                  "if (pm.response.code === 200) { pm.test(\"draft only\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"draft\", \"missing\", \"aiStatus\"); }); }"
                ]
              }
            }
          ]
        }
      ]
    },
