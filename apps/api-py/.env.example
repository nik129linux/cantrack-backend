OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WEB_ORIGIN=http://localhost:5173
HF_TOKEN=
# "production" hides /docs and /openapi.json and makes the server refuse to boot
# without SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and an https WEB_ORIGIN.
ENV=
# Proxies allowed to set X-Forwarded-For (Render's network), so rate limits see real client IPs.
TRUSTED_PROXY_IPS=127.0.0.1
# Session pooler URL (the direct db.<ref>.supabase.co host is IPv6-only). Only for psql migrations.
DATABASE_URL=
